# ---------------------------------------------------------------------------
# מטפסים בסולם | نتسلّق السُلّم — environment configuration
# Copy to `.env` and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL 15+ with the pgvector extension (CREATE EXTENSION vector).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/kidsai?schema=public"
# Neon: DATABASE_URL is the pooled URL (app traffic); the Prisma CLI (migrate, seed) uses this
# direct URL when it is set. Leave empty locally. `neon env pull --file .env.neon` writes both.
DATABASE_URL_UNPOOLED=""
# Separate database used by integration tests (created/migrated by `npm run test:db:prepare`).
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/kidsai_test?schema=public"

# Signs the admin session cookie (HS256). 32+ random bytes, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Bootstrap admin account created by `npm run db:seed` (password is hashed with bcrypt).
ADMIN_EMAIL="admin@example.org"
ADMIN_PASSWORD=""

# Answer generation. "anthropic" uses Claude for the short explanation; "none" serves
# a deterministic extractive answer built only from retrieved handbook text.
# Retrieval, milestone identification and video selection never depend on the LLM.
LLM_PROVIDER="none"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# Multilingual embeddings computed locally (transformers.js / ONNX). The vector
# column is vector(384); changing the model to a different dimension needs a migration.
EMBEDDING_MODEL="Xenova/multilingual-e5-small"
EMBEDDING_DIM="384"
MODEL_CACHE_DIR="./.cache/models"

# Source files and uploads.
SOURCE_FILES_DIR="./source-files"
UPLOAD_DIR="./storage/uploads"

# Python 3.11+ with PyMuPDF + openpyxl (ingestion/requirements.txt), used by the
# import worker for PDF parsing and for the workbook audit.
PYTHON_BIN="python3"

# Optional: requests per minute per client for /api/chat (default 20).
CHAT_RATE_LIMIT_PER_MIN="20"
MODEL_DIR="./models"

# ONNX intra-op threads for local embeddings (keep small on shared/hybrid CPUs).
EMBEDDING_THREADS="4"
# Effort for the short grounded explanation (low|medium|high). Opus 5.5 defaults to medium.
ANTHROPIC_EFFORT="medium"

# Rate-limit store: "memory" (single instance) or "postgres" (shared by all instances).
RATE_LIMIT_STORE="memory"

# Shared deployment: when set, the whole site asks for this password (HTTP Basic auth,
# any user name). Leave empty locally. Set it in the hosting platform, never in code.
SITE_PASSWORD=""
