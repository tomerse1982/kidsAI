{
  "name": "kidsai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx scripts/seed-admin.ts",
    "db:purge": "tsx scripts/purge-conversations.ts",
    "model:download": "sh scripts/download-model.sh",
    "import:sources": "tsx scripts/import-sources.ts",
    "import:worker": "tsx scripts/worker.ts",
    "videos:check": "tsx scripts/check-videos.ts",
    "report": "tsx scripts/report.ts",
    "smoke": "tsx scripts/smoke.ts",
    "icons": "node scripts/generate-icons.mjs",
    "eval": "tsx scripts/eval.ts",
    "questions:check": "tsx scripts/check-question-bank.ts",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:db:prepare": "tsx scripts/test-db-prepare.ts",
    "test:python": "python -X utf8 -m pytest ingestion/tests -q",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@huggingface/transformers": "4.3.0",
